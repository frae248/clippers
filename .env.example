# GEMINI_API_KEY: Required for Gemini AI audio transcription and clip moment analysis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# Processing & Storage Configuration
STORAGE_BUCKET=clipforge-videos
MAX_UPLOAD_SIZE=1073741824
WORKER_CONCURRENCY=2

# Optional External Supabase + Redis + Python Worker Configuration
# (Built-in SQLite + local FFmpeg worker runs automatically when these are unset)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
REDIS_URL=
TRANSCRIPTION_API_KEY=
YOUTUBE_API_KEY=
